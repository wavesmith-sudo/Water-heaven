{
  "components": {
    "schemas": {
      "DeviceCreate": {
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DeviceCreate",
        "type": "object"
      },
      "FeaturePatch": {
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "FeaturePatch",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Heartbeat": {
        "properties": {
          "firmware": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Firmware",
            "type": "string"
          }
        },
        "required": [
          "firmware"
        ],
        "title": "Heartbeat",
        "type": "object"
      },
      "SettingsPatch": {
        "properties": {
          "audio_output": {
            "anyOf": [
              {
                "pattern": "^(hdmi|bluetooth)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Output"
          },
          "jellyfin_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jellyfin Enabled"
          },
          "resolution": {
            "anyOf": [
              {
                "pattern": "^(auto|1080p|4k)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          },
          "theme": {
            "anyOf": [
              {
                "pattern": "^(retro-arcade|minimal-tv|modern-media)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
