          "enabled"
        ],
        "title": "FeaturePatch",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Heartbeat": {
        "properties": {
          "firmware": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Firmware",
            "type": "string"
          }
        },
        "required": [
          "firmware"
        ],
        "title": "Heartbeat",
        "type": "object"
      },
      "PairingApprove": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "PairingApprove",
        "type": "object"
      },
      "PairingPoll": {
        "properties": {
          "device_code": {
            "maxLength": 128,
            "minLength": 20,
            "title": "Device Code",
            "type": "string"
          }
        },
        "required": [
          "device_code"
        ],
        "title": "PairingPoll",
        "type": "object"
      },
      "PairingStart": {
        "properties": {
          "device_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Device Name",
            "type": "string"
          },
          "firmware": {
            "default": "unknown",
            "maxLength": 60,
            "minLength": 1,
            "title": "Firmware",
            "type": "string"
          }
        },
        "required": [
          "device_name"
        ],
        "title": "PairingStart",
        "type": "object"
      },
      "SettingsPatch": {
        "properties": {
          "audio_output": {
            "anyOf": [
              {
                "pattern": "^(hdmi|bluetooth)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Output"
          },
          "jellyfin_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jellyfin Enabled"
          },
          "resolution": {
            "anyOf": [
              {
                "pattern": "^(auto|1080p|4k)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          },
          "theme": {
            "anyOf": [
              {
                "pattern": "^(retro-arcade|minimal-tv|modern-media)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
