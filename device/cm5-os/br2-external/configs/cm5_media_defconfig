# CM5 Media OS fragment. Merge onto Buildroot's raspberrypicm5io_defconfig with
# scripts/configure.sh. Validated with `make olddefconfig` against the Buildroot release
# pinned in toolchain.lock (every symbol below survives; see scripts/check_config.py).
# Not yet built end to end or booted on the Waveshare CM5-NANO-B.

BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_CM5_MEDIA_PATH}/board/cm5/overlay"
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"

# --- Graphics: Mesa V3D (render) + VC4 (KMS display) so Qt can use EGLFS/KMS.
# Without an EGL/GBM provider BR2_PACKAGE_QT6BASE_EGLFS is silently dropped (v0.3 bug).
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# --- Qt 6
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
# BR2_PACKAGE_QT6BASE_WIDGETS is not set
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="eglfs"
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6DECLARATIVE=y
# v0.3 omitted this; without it Qt Quick (and therefore the whole UI) is not built.
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_QT6MULTIMEDIA=y
BR2_PACKAGE_QT6MULTIMEDIA_ALSA=y
BR2_PACKAGE_QT6MULTIMEDIA_GSTREAMER=y
# The GStreamer plugin includes QtConcurrent, but Buildroot 2026.02.3 only selects it for the
# ffmpeg plugin. Without this, qt6multimedia fails: "QtConcurrent/QtConcurrentRun: No such file".
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_DEJAVU=y

# --- TLS for HTTPS to Jellyfin and the cloud API
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# --- GStreamer pipeline for Qt Multimedia (direct play of MP4/MKV over HTTP(S)).
# CM5 has no H.264 hardware decoder (HEVC only); H.264 is software-decoded by gst1-libav.
# HEVC hardware decode needs gst v4l2codecs, which needs udev (eudev/systemd) instead of
# the base defconfig's mdev. Follow-up once the init system is chosen.
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PLAYBACK=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_TYPEFIND=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOCONVERT=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORESAMPLE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VOLUME=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_SOUPHTTPSRC=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
# Server transcodes arrive as HLS with MPEG-TS segments (app/playbackprofile.cpp). hlsdemux uses
# OpenSSL (enabled below) for AES-128 segments, so it does not pull in nettle.
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_HLS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_MPEGTSDEMUX=y
BR2_PACKAGE_GST1_LIBAV=y

# --- Wi-Fi and Bluetooth remote
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y

# --- The home screen
BR2_PACKAGE_CM5_HOME=y
